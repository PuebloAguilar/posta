# Configuration only. Real .env and plow-credentials are excluded from Git/build.
# Use the API root; the CLI adds /public/v1. For a self-hosted reverse proxy:
POSTIZ_API_URL=https://your-postiz-host.example/api
# Provision this key outside iMessage. Leave empty only when using stored OAuth.
POSTIZ_API_KEY=
AGENT_TIMEZONE=America/Sao_Paulo
# For self-hosted device login, use your instance's supported auth server.
# POSTIZ_AUTH_SERVER=https://your-postiz-cli-auth.example
# Optional inference provider. Authenticate independently in the agent volume first.
# HERMES_PROVIDER=openai-codex
# HERMES_MODEL=gpt-6.1-sol
