# Default: connect your own Postiz via the link/code sent in iMessage.
# No API key is required here for cloud OAuth. Confirm the owner's timezone.
AGENT_TIMEZONE=UTC
# POSTA_POSTIZ_DASHBOARD_URL=https://platform.postiz.com
# POSTA_POSTIZ_AUTH_SERVER=https://cli-auth.postiz.com
# Optional self-hosted API-key mode: use compose.self-hosted.yml explicitly.
# Provision your OWN key outside chat; .env is private and excluded from build.
# POSTA_SELF_HOSTED_API_URL=https://your-postiz-host.example/api
# POSTA_SELF_HOSTED_API_KEY=
# POSTA_POSTIZ_DASHBOARD_URL=https://your-postiz-host.example
# Optional inference provider; authenticate in this installation's volume first.
# HERMES_PROVIDER=openai-codex
# HERMES_MODEL=gpt-6.1-sol
